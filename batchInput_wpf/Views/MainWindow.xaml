<Window x:Class="batchInput_wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:batchInput_wpf"
        mc:Ignorable="d"
        Title="[CYBER_CORE] :: ORDER CHECK SYSTEM v2.0" Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#07090E"
        Foreground="#00E5FF">

    <Window.Resources>
        <!-- HIGH-TECH NEON BUTTON - OPEN (CYAN/GREEN) -->
        <Style x:Key="OpenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A2A22"/>
            <Setter Property="Foreground" Value="#00FF99"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00FF99"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="16,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF99" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00FF99"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00CC77"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HIGH-TECH NEON BUTTON - START (ELECTRIC BLUE) -->
        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A1E3F"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="16,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00B8D4"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HIGH-TECH NEON BUTTON - PAUSE (CRIMSON RED) -->
        <Style x:Key="PauseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3D0A14"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF0055"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="16,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF0055" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#FF0055"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#CC0044"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP CYBER HEADER -->
        <Border Grid.Row="0" Background="#0D111A" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#00E5FF" BlurRadius="12" ShadowDepth="1" Opacity="0.3"/>
            </Border.Effect>

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- System Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="ORDER CHECK SYSTEM" 
                               FontWeight="Black" 
                               FontSize="20" 
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <Border Background="#00E5FF" Padding="5,2" Margin="12,0,0,0" CornerRadius="2" VerticalAlignment="Center">
                        <TextBlock Text="SYS_ONLINE" FontSize="9" FontWeight="Bold" Foreground="#07090E"/>
                    </Border>
                </StackPanel>

                <!-- Action Button: Open -->
                <Button Grid.Column="1"
                        x:Name="btn_lib"
                        Content="[📂] MO ANH"
                        Width="140"
                        Height="40"
                        Style="{StaticResource OpenButtonStyle}"
                        Click="btn_lib_Click"/>

                <!-- Action Buttons: Controls -->
                <Button Grid.Column="3"
                        x:Name="btn_start"
                        Content="▶ START_PROC"
                        Width="140"
                        Height="40"
                        Style="{StaticResource StartButtonStyle}"
                        Click="btn_start_Click"
                        Margin="15,0,0,0"/>

                <Button Grid.Column="4"
                        x:Name="btn_pause"
                        Content="⏸ PAUSE_PROC"
                        Width="140"
                        Height="40"
                        Style="{StaticResource PauseButtonStyle}"
                        Click="btn_Pause_Click"
                        Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- MAIN DASHBOARD CONTENT -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- TOP PANEL: EXPANDABLE ORDERS DATA MATRIX -->
            <Border Grid.Row="0" Background="#0D111A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0" Background="#141B2D" BorderBrush="#00E5FF" BorderThickness="2,0,0,1" Padding="15,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="/// BATCH OPERATIONS MATRIX" FontSize="12" FontWeight="Black" Foreground="#00E5FF"/>
                            <TextBlock Text=" (Click row to expand PO nodes)" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" Text="ID" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="TERMINAL_ID" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="MACHINE" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="START_TIME" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="MSNV" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="SHIFT" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="TOTAL_PO" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="DATE_CREATED" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Text="numRetry" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="11" Text="Description" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- TreeView Matrix -->
                    <TreeView Grid.Row="2"
                              x:Name="OrderTreeView" 
                              ItemsSource="{Binding BatchInputHistories}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding ListPO}">
                                <!-- Parent Row (Batch Item) -->
                                <Border Padding="0" Margin="0,1" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0D111A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Background" Value="#2A2400"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                    <Setter Property="Background" Value="#0A2A18"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="#3D0A14"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid Background="Transparent" Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="1" Text="{Binding ID}" FontSize="11" Foreground="#00FF99" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TerminalID}" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Machine}" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding start}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Msnv}" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Shift}" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding ListPO.Count}" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="8" Text="{Binding isComplate}" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="9" Text="{Binding DateCreated}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="10" Text="{Binding numRetry}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="11" Text="{Binding description}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Child Row Template (PO Item) -->
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0" Margin="0" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                            <Grid Background="#06090F" Height="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="└─" Foreground="#00E5FF" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ID}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Po}" FontSize="11" Foreground="#00FF99" VerticalAlignment="Center" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="{Binding IDGroup}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding isComplate}" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding desPO}" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- BOTTOM SECTION: METRICS & CONSOLE LOG -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CHART / TELEMETRY PANEL -->
                <Border Grid.Column="0" Background="#0D111A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#141B2D" BorderBrush="#00E5FF" BorderThickness="2,0,0,1" Padding="15,10">
                            <TextBlock Text="/// TELEMETRY &amp; REALTIME METRICS" FontSize="12" FontWeight="Black" Foreground="#00E5FF"/>
                        </Border>

                        <!--<Grid Grid.Row="1" Background="#0A0E17" Margin="10">
                            <lvc:CartesianChart Series="{Binding Series}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}" />-->
                        <!--</Grid>-->
                    </Grid>
                </Border>

                <!-- SYSTEM CONSOLE / LOG PANEL -->
                <Border Grid.Column="1" Background="#0D111A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#141B2D" BorderBrush="#FF0055" BorderThickness="2,0,0,1" Padding="15,10">
                            <TextBlock Text="/// SYSTEM DIAGNOSTICS &amp; EVENT LOG" FontSize="12" FontWeight="Black" Foreground="#FF0055"/>
                        </Border>

                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding Log}"
                                 Background="#0A0E17"
                                 BorderThickness="0"
                                 Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <!-- Status Indicator Icon -->
                                        <TextBlock FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="[BUSY]"/>
                                                    <Setter Property="Foreground" Value="#FFB703"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                                            <Setter Property="Text" Value="[OK]"/>
                                                            <Setter Property="Foreground" Value="#00FF99"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Text" Value="[ERR]"/>
                                                            <Setter Property="Foreground" Value="#FF0055"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Text" Value="[RUN]"/>
                                                            <Setter Property="Foreground" Value="#00E5FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Timestamp -->
                                        <TextBlock Margin="10,0,0,0"
                                                   Text="{Binding Time}"
                                                   Foreground="#64748B"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"/>

                                        <!-- Log Message Content -->
                                        <TextBlock Margin="10,0,0,0"
                                                   Text="{Binding Message}"
                                                   Foreground="#E2E8F0"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
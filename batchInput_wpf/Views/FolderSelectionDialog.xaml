<Window x:Class="batchInput_wpf.Views.FolderSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:batchInput_wpf"
        mc:Ignorable="d"
        Title="[SYS_CONFIG] :: CONFIG_FOLDER_PATH" 
        Height="550" 
        Width="918"
        MinHeight="450"
        MinWidth="600"
        Background="#07090E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Foreground="#00E5FF">

    <Window.Resources>
        <!-- HIGH-TECH NEON BUTTON - PRIMARY (CYAN) -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A1E3F"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00B8D4"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HIGH-TECH NEON BUTTON - BROWSE 1 (GREEN) -->
        <Style x:Key="GreenBrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#0A2A22"/>
            <Setter Property="Foreground" Value="#00FF99"/>
            <Setter Property="BorderBrush" Value="#00FF99"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF99" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00FF99"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#00CC77"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HIGH-TECH NEON BUTTON - BROWSE 2 (ORANGE) -->
        <Style x:Key="OrangeBrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2A1B00"/>
            <Setter Property="Foreground" Value="#FF9800"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9800" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#07090E"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#E68A00"/>
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HIGH-TECH NEON BUTTON - CANCEL (DARK GREY) -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="BackBorder"
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP CYBER HEADER -->
        <Border Grid.Row="0" Background="#0D111A" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#00E5FF" BlurRadius="12" ShadowDepth="1" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" Margin="30,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="⚡" FontSize="18" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="CHỌN ĐƯỜNG DẪN THƯ MỤC" 
                               FontSize="20" 
                               FontWeight="Black" 
                               Foreground="#FFFFFF"/>
                </StackPanel>
                <TextBlock Text="/// Vui lòng thiết lập 2 đường dẫn thư mục để tiếp tục vận hành hệ thống" 
                           FontSize="11" 
                           Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,25">

                <!-- Folder 1 Card -->
                <Border Background="#0D111A" CornerRadius="4" Padding="16" BorderThickness="1" BorderBrush="#1E293B" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📂" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Nơi lưu hình ảnh lỗi" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="#00FF99"/>
                            </StackPanel>

                            <Border Background="#0A0E17" CornerRadius="2" Padding="12" BorderBrush="#1E293B" BorderThickness="1" Margin="0,4,0,0">
                                <TextBlock x:Name="txtFolder1" 
                                           Text="Chưa chọn đường dẫn"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="[📂] CHỌN FOLDER" 
                                Width="140"
                                Height="40"
                                VerticalAlignment="Center"
                                x:Name="btnBrowse1"
                                Click="BtnBrowse1_Click"
                                Style="{StaticResource GreenBrowseButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Folder 2 Card -->
                <Border Background="#0D111A" CornerRadius="4" Padding="16" BorderThickness="1" BorderBrush="#1E293B">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📂" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thư Mục chứa thông báo lỗi" 
                                               FontSize="13" 
                                               FontWeight="Bold" 
                                               Foreground="#FF9800"/>
                                    <TextBlock Text="Thư mục này sẽ đưa các thông báo lỗi lên Microsoft Teams" 
                                               FontSize="10" 
                                               Foreground="#64748B"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#0A0E17" CornerRadius="2" Padding="12" BorderBrush="#1E293B" BorderThickness="1" Margin="0,4,0,0">
                                <TextBlock x:Name="txtFolder2" 
                                           Text="Chưa chọn đường dẫn"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="[📂] CHỌN FOLDER" 
                                Width="140"
                                Height="40"
                                VerticalAlignment="Center"
                                x:Name="btnBrowse2"
                                Click="btnBrowse2_Click"
                                Style="{StaticResource OrangeBrowseButtonStyle}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#0D111A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info Text -->
                <TextBlock Grid.Column="0" 
                           VerticalAlignment="Center"
                           Text="✓ Cả 2 thư mục sẽ được tự động lưu lại cho các phiên làm việc tiếp theo" 
                           x:Name="txt_notify"
                           FontSize="11" 
                           Foreground="#64748B"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="HỦY BỎ" 
                            Width="110" 
                            Height="38"
                            Margin="0,0,12,0"
                            Click="Button_Click"
                            Style="{StaticResource CancelButtonStyle}"/>

                    <Button Content="XÁC NHẬN" 
                            Width="110" 
                            Height="38"
                            x:Name="btnOK"
                            Click="btnOK_Click"
                            Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
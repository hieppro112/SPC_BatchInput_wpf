<Window x:Class="batchInput_wpf.Views.FolderSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:batchInput_wpf"
        mc:Ignorable="d"
        Title="Chọn Đường Dẫn Thư Mục" 
        Height="459" 
        Width="918"
        Background="#FFFFFF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="#333333">

    <Window.Resources>
        <!-- Button Style Hover -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="8"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05" CenterX="0.5" CenterY="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="8"
                               Padding="{TemplateBinding Padding}">
                            <!-- Sử dụng TextBlock để bọc nội dung và nhận Foreground từ Button -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="71*"/>
            <ColumnDefinition Width="54*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="149*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Modern Header with Gradient -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2196F3" Offset="0"/>
                    <GradientStop Color="#1976D2" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Shadow Effect -->
            <Border Height="80">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
            </Border>

            <!-- Header Content -->
            <StackPanel VerticalAlignment="Center" Margin="40,0">
                <TextBlock Text="Chọn Đường Dẫn Thư Mục" 
                         FontSize="28" 
                         FontWeight="Bold" 
                         Foreground="White"
                         Margin="0,0,0,8"/>
                <TextBlock Text="Vui lòng chọn 2 thư mục để tiếp tục" 
                         FontSize="13" 
                         Foreground="#E3F2FD"
                         Opacity="0.9"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <StackPanel Margin="40,30,40,30">
                <!-- Folder 1 Card -->
                <Border Background="White" CornerRadius="12" Padding="10" BorderThickness="1" BorderBrush="#E0E0E0" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.08"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36.8"/>
                            <ColumnDefinition Width="113.2"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📂" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Nơi lưu hình ảnh lỗi" 
                                             FontSize="14" 
                                             FontWeight="Bold" 
                                             Foreground="#1976D2"
                                             Margin="0,0,0,2"/>

                                </StackPanel>
                            </StackPanel>

                            <Border Background="#F5F5F5" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                                <TextBlock x:Name="txtFolder1" 
                                           Text="Chưa chọn đường dẫn"
                                           FontSize="12"
                                           Foreground="#666666"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="Chọn Folder" 
                                Width="130"
                                Height="50"
                                Margin="20,23,0,24"
                                Background="#4CAF50" 
                                Foreground="White"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                x:Name="btnBrowse1"
                                Click="BtnBrowse1_Click"
                                Style="{StaticResource ModernButtonStyle}" Grid.ColumnSpan="2"/>
                    </Grid>
                </Border>

                <!-- Folder 2 Card -->
                <Border Background="White" CornerRadius="12" Padding="10" BorderThickness="1" BorderBrush="#E0E0E0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.08"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📂" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thư Mục chứa thông báo lỗi" 
                                             FontSize="14" 
                                             FontWeight="Bold" 
                                             Foreground="#FF9800"
                                             Margin="0,0,0,2"/>
                                    <TextBlock Text="Thư mục này sẽ đưa các lỗi lên teams" 
                                             FontSize="11" 
                                             Foreground="#999999"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#F5F5F5" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                                <TextBlock x:Name="txtFolder2" 
                                           Text="Chưa chọn đường dẫn"
                                           FontSize="12"
                                           Foreground="#666666"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="Chọn Folder" 
                                Width="130"
                                Height="50"
                                Margin="20,0,0,0"
                                Background="#FF9800" 
                                Foreground="White"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                x:Name="btnBrowse2"
                                Click="btnBrowse2_Click"
                                Style="{StaticResource ModernButtonStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10,10" Grid.ColumnSpan="2" Margin="0,282,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info Text -->
                <TextBlock Grid.Column="0" 
                         VerticalAlignment="Center"
                         Text="✓ Cả 2 thư mục sẽ được lưu lại cho lần sử dụng tiếp theo" 
                           x:Name="txt_notify"
                         FontSize="11" 
                         Foreground="#999999"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" 
                            Width="110" 
                            Height="45"
                            Margin="0,0,12,0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Button_Click"
                            Style="{StaticResource CancelButtonStyle}"/>

                    <Button Content="Xác Nhận" 
                            Width="110" 
                            Height="45"
                            FontSize="12"
                            Cursor="Hand"
                            x:Name="btnOK"
                            Click="btnOK_Click"
                            Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
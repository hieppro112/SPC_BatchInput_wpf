  <!--
    Playwright kèm tài liệu .md cho AI (lib\tools\skills\..., bản cũ là lib\tools\cli-client\skill\...),
    app không dùng khi chạy. Đường dẫn các file này lồng rất sâu nên khi publish ClickOnce vượt 260 ký tự
    và publish bị lỗi. Bỏ chúng khỏi build / publish (chạy sau target CopyPlaywrightFilesToOutput của Playwright).
  -->
  <Target Name="RemovePlaywrightSkillDocs" AfterTargets="CopyPlaywrightFilesToOutput">
    <ItemGroup>
      <_PlaywrightSkillDocs Include="@(Content)"
                            Condition="'%(Content.NuGetPackageId)' == 'Microsoft.Playwright' And '%(Content.Extension)' == '.md' And $([System.String]::Copy('%(Content.Link)').Contains('\tools\')) And $([System.String]::Copy('%(Content.Link)').Contains('\skill'))" />
      <Content Remove="@(_PlaywrightSkillDocs)" />
    </ItemGroup>
  </Target>

